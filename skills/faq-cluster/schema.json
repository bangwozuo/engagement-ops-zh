{
  "skill_id": "de_media_03_sk02",
  "name": "高频问题聚类",
  "type": "atomic",
  "input": {
    "type": "object",
    "required": ["questions"],
    "properties": {
      "account": {"type": "string", "description": "账号名"},
      "period": {"type": "string", "description": "统计周期，如 2026-09-23 ~ 2026-09-29"},
      "questions": {
        "type": "array",
        "description": "提问类评论列表（先经情感分类剔除吐槽）",
        "items": {
          "oneOf": [
            {"type": "string"},
            {"type": "object", "properties": {"text": {"type": "string"}}}
          ]
        }
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["summary", "clusters", "faq"],
    "properties": {
      "summary": {
        "type": "object",
        "description": "原始提问数 / 独立问法数 / 聚类簇数 / Top10 覆盖率 / 判定",
        "properties": {
          "原始提问数": {"type": "integer"},
          "归一化后独立问法数": {"type": "integer"},
          "聚类簇数": {"type": "integer"},
          "Top10 覆盖率": {"type": "string"},
          "判定": {"type": "string", "enum": ["正常", "分类有误/问题过散，需人工复核"]}
        }
      },
      "clusters": {
        "type": "array",
        "description": "全部问题簇，按频次降序",
        "items": {
          "type": "object",
          "properties": {
            "簇ID": {"type": "string"},
            "代表问题": {"type": "string"},
            "簇内变体数": {"type": "integer"},
            "提问频次": {"type": "integer"},
            "占总提问": {"type": "string"},
            "是否进FAQ库": {"type": "string"}
          }
        }
      },
      "faq": {
        "type": "array",
        "description": "FAQ 库 Top 10",
        "items": {
          "type": "object",
          "properties": {
            "FAQ排名": {"type": "integer"},
            "标准问法": {"type": "string"},
            "提问频次": {"type": "integer"},
            "建议答案要点": {"type": "string"},
            "回复口径限制": {"type": "string"}
          }
        }
      }
    }
  },
  "scripts": {
    "cluster": "scripts/faq_cluster.py",
    "usage": "python3 scripts/faq_cluster.py --input input.json --outdir out"
  },
  "artifacts": ["out/高频问题聚类.xlsx", "out/faq_top10.png", "out/faq_cluster.json"],
  "constraints": {
    "merge_threshold": 0.6,
    "coverage_floor": 0.6,
    "top_n_faq": 10,
    "no_offsite_redirect_in_answers": true,
    "no_effect_promises": true,
    "human_review_required": true
  }
}
